// Copy to Local.xcconfig and fill in. That file is gitignored.
//
// Your Team ID is in Xcode under Settings > Accounts, or at
// developer.apple.com/account under Membership Details. Only needed to run on
// a physical device.

DEVELOPMENT_TEAM = ABCDE12345

// Optional: use your own bundle identifier prefix.
// MOQOM_BUNDLE_PREFIX = com.yourname.moqom

